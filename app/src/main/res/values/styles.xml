<resources>
    <style name="Theme.AppCompat.Light.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="colorControlActivated">@color/gold</item>
        <item name="colorControlHighlight">@color/gold_dark</item>
    </style>

    <style name="ChipGold" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/bg_card</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeColor">@color/gold_dark</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:focusable">true</item>
        <item name="android:nextFocusDown">@id/seek_60</item>
    </style>

    <style name="SeekGold">
        <item name="android:progressDrawable">@drawable/seek_bg</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:maxHeight">60dp</item>
        <item name="android:focusable">true</item>
        <item name="android:splitTrack">false</item>
    </style>
</resources>
