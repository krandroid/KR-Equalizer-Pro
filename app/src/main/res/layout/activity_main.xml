<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:padding="40dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KR EQUALIZER PRO"
        android:textColor="@color/gold"
        android:textSize="42sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:singleSelection="true"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip android:id="@+id/chip_flat" style="@style/ChipGold" android:text="Flat" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_bass" style="@style/ChipGold" android:text="Bass" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_full_bass" style="@style/ChipGold" android:text="Full Bass" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_bass_treble" style="@style/ChipGold" android:text="Bass Treble" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_vocal" style="@style/ChipGold" android:text="Vocal" />
        <com.google.android.material.chip.Chip android:id="@+id/chip_headphones" style="@style/ChipGold" android:text="Headphones" />
    </com.google.android.material.chip.ChipGroup>

    <!-- BAND 60Hz -->
    <TextView
        android:id="@+id/txt_60"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="60Hz"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/chipGroup"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seek_60"
        style="@style/SeekGold"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:max="30"
        android:progress="15"
        android:nextFocusUp="@id/chip_flat"
        android:nextFocusRight="@id/seek_230"
        app:layout_constraintTop_toTopOf="@id/txt_60"
        app:layout_constraintBottom_toBottomOf="@id/txt_60"
        app:layout_constraintStart_toEndOf="@id/txt_60"
        app:layout_constraintEnd_toStartOf="@id/db_60"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/db_60"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="0dB"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/seek_60"
        app:layout_constraintBottom_toBottomOf="@id/seek_60"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BAND 230Hz -->
    <TextView
        android:id="@+id/txt_230"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="230Hz"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txt_60"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seek_230"
        style="@style/SeekGold"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:max="30"
        android:progress="15"
        android:nextFocusLeft="@id/seek_60"
        android:nextFocusRight="@id/seek_910"
        app:layout_constraintTop_toTopOf="@id/txt_230"
        app:layout_constraintBottom_toBottomOf="@id/txt_230"
        app:layout_constraintStart_toEndOf="@id/txt_230"
        app:layout_constraintEnd_toStartOf="@id/db_230"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/db_230"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="0dB"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/seek_230"
        app:layout_constraintBottom_toBottomOf="@id/seek_230"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BAND 910Hz -->
    <TextView
        android:id="@+id/txt_910"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="910Hz"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txt_230"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seek_910"
        style="@style/SeekGold"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:max="30"
        android:progress="15"
        android:nextFocusLeft="@id/seek_230"
        android:nextFocusRight="@id/seek_3k6"
        app:layout_constraintTop_toTopOf="@id/txt_910"
        app:layout_constraintBottom_toBottomOf="@id/txt_910"
        app:layout_constraintStart_toEndOf="@id/txt_910"
        app:layout_constraintEnd_toStartOf="@id/db_910"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/db_910"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="0dB"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/seek_910"
        app:layout_constraintBottom_toBottomOf="@id/seek_910"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BAND 3.6kHz -->
    <TextView
        android:id="@+id/txt_3k6"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="3.6kHz"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txt_910"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seek_3k6"
        style="@style/SeekGold"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:max="30"
        android:progress="15"
        android:nextFocusLeft="@id/seek_910"
        android:nextFocusRight="@id/seek_14k"
        app:layout_constraintTop_toTopOf="@id/txt_3k6"
        app:layout_constraintBottom_toBottomOf="@id/txt_3k6"
        app:layout_constraintStart_toEndOf="@id/txt_3k6"
        app:layout_constraintEnd_toStartOf="@id/db_3k6"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/db_3k6"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="0dB"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/seek_3k6"
        app:layout_constraintBottom_toBottomOf="@id/seek_3k6"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BAND 14kHz -->
    <TextView
        android:id="@+id/txt_14k"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="14kHz"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txt_3k6"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seek_14k"
        style="@style/SeekGold"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:max="30"
        android:progress="15"
        android:nextFocusLeft="@id/seek_3k6"
        app:layout_constraintTop_toTopOf="@id/txt_14k"
        app:layout_constraintBottom_toBottomOf="@id/txt_14k"
        app:layout_constraintStart_toEndOf="@id/txt_14k"
        app:layout_constraintEnd_toStartOf="@id/db_14k"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/db_14k"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="0dB"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/seek_14k"
        app:layout_constraintBottom_toBottomOf="@id/seek_14k"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
